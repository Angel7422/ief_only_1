<%= form_with model: child do |f| %>
  <% if child.errors.any? %>
    <div>
      <h3><%= pluralize(child.errors.count, "erreur") %></h3>
      <ul>
        <% child.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :full_name, "Nom complet" %>
    <%= f.text_field :full_name %>
  </div>

  <div>
    <%= f.label :birth_date, "Date de naissance" %>
    <%= f.date_field :birth_date %>
  </div>

  <div>
    <%= f.label :cycle, "Cycle" %>
    <%= f.text_field :cycle %>
  </div>

  <div>
    <%= f.submit %>
  </div>
<% end %>
